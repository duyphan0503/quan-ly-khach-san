
@model List<HotelManagement.Core.Models.Guest>

@if (Model != null && Model.Any())
{
    foreach (var guest in Model)
    {
        var normalizedAvatarUrl = HotelManagement.Helpers.AvatarUrlHelper.ResolveOrDefault(guest.AvatarUrl);

        <tr class="group hover:bg-white/[0.03] transition-all duration-300 border-b border-white/5 last:border-0 h-24">
            <!-- Thông tin nhận diện chính của khách -->
            <td class="py-5 pl-10">
                <div class="flex items-center gap-4">
                    <div class="relative">
                        <div class="h-14 w-14 rounded-full overflow-hidden ring-2 ring-primary/40 border border-white/20 shadow-2xl transition-transform group-hover:scale-105 duration-500 bg-surface-3/50 backdrop-blur-md mq-shadow-premium">
                            <img src="@normalizedAvatarUrl" 
                                 alt="@guest.FullName" class="h-full w-full object-cover" />
                        </div>
                    </div>
                    <div class="flex flex-col gap-0.5 text-left">
                        <span class="text-base font-black text-content-primary tracking-tight group-hover:text-primary transition-colors duration-300">
                            @guest.FullName
                        </span>
                        <div class="flex items-center gap-2">
                            <div class="flex items-center gap-1.5 px-2 py-0.5 bg-white/5 rounded-lg border border-white/10">
                                <span class="text-[10px] font-bold text-content-muted uppercase tracking-tighter">@(string.IsNullOrEmpty(guest.Nationality) ? "Việt Nam" : guest.Nationality)</span>
                            </div>
                        </div>
                    </div>
                </div>
            </td>

            <!-- Giấy tờ định danh (CCCD/Hộ chiếu) -->
            <td class="py-5 text-left">
                @if (!string.IsNullOrEmpty(guest.CCCD))
                {
                    <div class="flex flex-col">
                        <div class="flex items-center gap-2 text-content-primary font-mono font-medium tracking-widest text-sm bg-surface-3/30 px-3 py-1.5 rounded-xl border border-white/5 w-fit">
                            <iconify-icon icon="solar:card-2-bold-duotone" class="text-primary text-lg opacity-70"></iconify-icon>
                            @guest.CCCD
                        </div>
                    </div>
                }
                else
                {
                    <span class="text-[10px] text-content-muted italic uppercase tracking-widest opacity-30">Chưa cập nhật</span>
                }
            </td>

            <!-- Kênh liên hệ chính -->
            <td class="py-5 text-left">
                <div class="flex flex-col gap-1.5">
                    <div class="flex items-center gap-2 text-content-secondary group/contact">
                        <div class="w-6 h-6 rounded-lg bg-primary/10 flex items-center justify-center group-hover/contact:bg-primary transition-colors duration-300">
                            <iconify-icon icon="solar:phone-calling-bold-duotone" class="text-sm text-primary group-hover/contact:text-white"></iconify-icon>
                        </div>
                        <span class="text-xs font-bold tracking-tight">@guest.PhoneNumber</span>
                    </div>
                    @if (!string.IsNullOrEmpty(guest.Email))
                    {
                        <div class="flex items-center gap-2 text-content-muted group/email">
                            <div class="w-6 h-6 rounded-lg bg-white/5 flex items-center justify-center group-hover/email:bg-success/20 transition-colors duration-300">
                                <iconify-icon icon="solar:letter-bold-duotone" class="text-xs text-content-muted group-hover/email:text-success"></iconify-icon>
                            </div>
                            <span class="text-[11px] truncate max-w-[150px] font-medium opacity-80 group-hover/email:opacity-100">@guest.Email</span>
                        </div>
                    }
                </div>
            </td>

            <!-- Ngày tạo hồ sơ khách trong hệ thống -->
            <td class="py-5 text-left">
                <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/5 rounded-xl border border-white/10 text-content-muted shadow-inner">
                    <iconify-icon icon="solar:calendar-date-bold-duotone" class="text-accent opacity-60"></iconify-icon>
                    <span class="text-xs font-black uppercase tracking-tighter">@guest.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>
            </td>

            <!-- Thao tác nhanh trên từng hồ sơ -->
            <td class="py-5 text-right pr-10">
                <div class="flex justify-end items-center">
                    <!-- Cụm nút thao tác: xem, sửa, xóa -->
                    <div class="flex items-center gap-1 p-1 bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 shadow-2xl relative">
                        <a asp-page="./Details" asp-route-id="@guest.Id" 
                           class="btn btn-ghost btn-square btn-sm rounded-xl text-content-secondary hover:text-primary hover:bg-primary/10 transition-all duration-300"
                           title="Xem Chi Tiết">
                            <iconify-icon icon="solar:eye-bold-duotone" width="18" height="18"></iconify-icon>
                        </a>
                        
                        <a asp-page="./Edit" asp-route-id="@guest.Id" 
                           class="btn btn-ghost btn-square btn-sm rounded-xl text-content-secondary hover:text-accent hover:bg-accent/10 transition-all duration-300"
                           title="Chỉnh Sửa">
                            <iconify-icon icon="solar:pen-new-square-bold-duotone" width="18" height="18"></iconify-icon>
                        </a>

                        <div class="w-px h-6 bg-white/10 mx-0.5"></div>

                        <button type="button" 
                                data-guest-delete-trigger
                                data-guest-id="@guest.Id"
                                data-guest-name="@guest.FullName"
                                class="btn btn-ghost btn-square btn-sm rounded-xl text-content-muted hover:text-red-500 hover:bg-red-500/10 transition-all duration-300"
                                title="Xóa Khách Hàng">
                            <iconify-icon icon="solar:trash-bin-trash-bold-duotone" width="18" height="18"></iconify-icon>
                        </button>
                    </div>
                </div>
            </td>
        </tr>
    }
}
