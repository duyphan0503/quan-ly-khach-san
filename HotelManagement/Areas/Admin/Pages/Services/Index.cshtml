@page "/admin/services"
@model HotelManagement.Areas.Admin.Pages.Services.IndexModel
@{
    ViewData["Title"] = "Danh Mục Dịch Vụ";
}

<div class="mb-6 space-y-6">
    <partial name="~/Areas/Admin/Pages/Shared/_AdminPageHeader.cshtml" model='new HotelManagement.Areas.Admin.Pages.Shared.AdminPageHeaderModel
    {
        HeadingTag = "h1",
        Icon = "solar:cup-hot-bold-duotone",
        Title = "Dịch Vụ Khách Sạn",
        Subtitle = "Cung cấp tiện ích và trải nghiệm dịch vụ đẳng cấp 5 sao"
    }' />
    
    <div class="w-full">
        <div class="flex w-full flex-wrap items-center gap-3">
            <form method="get" class="flex min-w-0 flex-wrap items-center gap-2">
            <div class="relative group">
                <input type="text" asp-for="SearchQuery" placeholder="Tìm dịch vụ..." 
                       class="input input-bordered bg-surface-2/50 border-bdr-strong/50 text-content-primary focus:border-primary focus:ring-1 focus:ring-primary w-80 rounded-xl pl-10 transition-all duration-300 backdrop-blur-md" />
                <iconify-icon icon="solar:magnifying-glass-bold-duotone" 
                              class="absolute left-3 top-1/2 -translate-y-1/2 text-content-muted group-focus-within:text-primary transition-colors"></iconify-icon>
            </div>

            <select asp-for="IsActiveFilter" class="select bg-surface-2/50 border-bdr-strong/50 text-content-primary focus:border-primary rounded-xl">
                <option value="">Tất cả trạng thái</option>
                <option value="true">Đang bán</option>
                <option value="false">Ngưng bán</option>
            </select>

            <button type="submit" class="btn btn-square rounded-xl bg-primary/20 hover:bg-primary text-primary hover:text-white border border-primary/30 transition-all duration-300" title="Lọc">
                <iconify-icon icon="solar:filter-bold-duotone" width="18" height="18"></iconify-icon>
            </button>

            @if (!string.IsNullOrWhiteSpace(Model.SearchQuery) || Model.IsActiveFilter.HasValue)
            {
                <a asp-page="./Index" class="btn btn-square rounded-xl border border-white/10 hover:border-red-400/40 hover:bg-red-500/10 text-content-muted hover:text-red-400 transition-all" title="Xóa bộ lọc">
                    <iconify-icon icon="solar:close-circle-bold-duotone" width="18" height="18"></iconify-icon>
                </a>
            }
            </form>

            <a asp-page="./Create" class="btn bg-gradient-to-br from-primary to-primary-700 hover:from-primary/90 hover:to-primary text-white border-none shadow-lg shadow-primary/20 hover:shadow-primary/40 hover:-translate-y-0.5 transition-all duration-300 rounded-2xl px-6 md:ml-auto">
            <span class="flex items-center gap-2"><iconify-icon icon="solar:add-circle-bold-duotone" class="text-xl"></iconify-icon> Thêm Dịch Vụ</span>
            </a>
        </div>
    </div>
</div>

<partial name="~/Areas/Admin/Pages/Shared/_AdminFlashMessages.cshtml" />

<div class="card bg-surface-2 border border-bdr-strong/50 shadow-xl overflow-hidden">
    <div class="overflow-x-auto">
        <table class="table table-zebra w-full text-content-secondary mq-row-fade">
            <thead>
                <tr class="text-content-muted border-bdr-strong bg-surface-1/50">
                    <th class="font-medium text-sm">ID</th>
                    <th class="font-medium text-sm">Tên dịch vụ</th>
                    <th class="font-medium text-sm">Đơn giá (VNĐ)</th>
                    <th class="font-medium text-sm text-center">Đơn vị tính</th>
                    <th class="font-medium text-sm text-center">Trạng thái</th>
                    <th class="font-medium text-sm text-right">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Services != null && Model.Services.Any())
                {
                    <partial name="_ServiceRows" model="Model.Services" />
                }
                else
                {
                    <partial name="~/Areas/Admin/Pages/Shared/_AdminTableEmptyState.cshtml" model='new HotelManagement.Areas.Admin.Pages.Shared.AdminTableEmptyStateModel
                    {
                        ColSpan = 6,
                        Icon = "solar:bell-bing-bold-duotone",
                        Title = "Không tìm thấy dịch vụ nào",
                        Description = "Vui lòng thử thay đổi từ khóa hoặc bộ lọc trạng thái."
                    }' />
                }
            </tbody>
        </table>
    </div>

    <partial name="~/Areas/Admin/Pages/Shared/_AdminPagination.cshtml" model='new HotelManagement.Areas.Admin.Pages.Shared.AdminPaginationModel
    {
        AspPage = "./Index",
        PageNumber = Model.PageNumber,
        TotalPages = Model.TotalPages,
        CurrentCount = Model.Services?.Count ?? 0,
        TotalCount = Model.TotalCount,
        ItemLabel = "dịch vụ",
        RouteValues = new Dictionary<string, string?>
        {
            ["searchQuery"] = Model.SearchQuery,
            ["isActiveFilter"] = Model.IsActiveFilter?.ToString()
        }
    }' />
</div>
