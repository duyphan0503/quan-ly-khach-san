
@model List<HotelManagement.Core.Models.RoomType>

@foreach (var item in Model)
{
    <tr class="hover:bg-surface-3/10 transition-colors group">
        <td class="py-4 pl-8">
            <div class="flex items-center gap-4">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <div class="avatar shadow-lg shadow-black/20 ring-2 ring-primary/20 rounded-xl overflow-hidden">
                        <div class="w-20 h-16 rounded-xl">
                            @{
                                var rtWebp = item.ImageUrl.EndsWith(".jpg") ? item.ImageUrl.Replace(".jpg", ".webp") : item.ImageUrl;
                            }
                            <picture>
                                <source srcset="@rtWebp" type="image/webp">
                                <img src="@item.ImageUrl"
                                     width="80" height="64"
                                     loading="lazy"
                                     alt="@item.Name"
                                     class="object-cover w-full h-full" />
                            </picture>
                        </div>
                    </div>
                }
                else
                {
                    <div class="w-20 h-16 bg-surface-3/50 rounded-xl flex items-center justify-center text-[10px] text-content-muted border border-bdr-strong/50">
                        <iconify-icon icon="solar:gallery-bold-duotone" class="h-6 w-6 opacity-30 text-secondary"></iconify-icon>
                    </div>
                }
                <div>
                    <div class="font-bold text-content-primary text-lg">@item.Name</div>
                    <div class="text-xs text-content-muted font-mono">ID: RT-@item.Id.ToString("D3")</div>
                </div>
            </div>
        </td>
        <td class="py-4">
            <div class="flex flex-col">
                <span class="text-primary font-bold text-lg font-mono">@item.BasePrice.ToString("N0") <span class="text-xs font-sans opacity-70">VNĐ</span></span>
                <span class="text-[10px] text-content-muted">Giá theo đêm cố định</span>
            </div>
        </td>
        <td class="py-4">
            <div class="flex items-center gap-2 text-content-primary bg-surface-3/50 w-fit px-3 py-1 rounded-full border border-bdr-strong/30">
                <iconify-icon icon="solar:users-group-two-rounded-bold-duotone" class="h-4 w-4 text-primary"></iconify-icon>
                <span class="font-medium">@item.MaxOccupancy người</span>
            </div>
        </td>
        <td class="py-4 text-right pr-8">
            <div class="flex justify-end items-center">
                <div class="flex items-center gap-1 p-1 bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 shadow-2xl">
                    <a asp-page="./Details" asp-route-id="@item.Id"
                       class="btn btn-ghost btn-square btn-sm rounded-xl text-content-secondary hover:text-primary hover:bg-primary/10 transition-all duration-300"
                       title="Xem Chi Tiết">
                        <iconify-icon icon="solar:eye-bold-duotone" width="18" height="18"></iconify-icon>
                    </a>

                    <a asp-page="./Edit" asp-route-id="@item.Id"
                       class="btn btn-ghost btn-square btn-sm rounded-xl text-content-secondary hover:text-accent hover:bg-accent/10 transition-all duration-300"
                       title="Chỉnh Sửa">
                        <iconify-icon icon="solar:pen-new-square-bold-duotone" width="18" height="18"></iconify-icon>
                    </a>
                </div>
            </div>
        </td>
    </tr>
}
