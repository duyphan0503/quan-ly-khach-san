@page "/admin/room-types/details/{id:int}"
@model HotelManagement.Areas.Admin.Pages.RoomTypes.DetailsModel
@{
    ViewData["Title"] = "Chi Tiết Loại Phòng";
}

<div class="mb-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
        <a asp-page="./Index" class="inline-flex items-center gap-2 rounded-xl border border-bdr-strong/70 bg-surface-2/70 px-3 py-2 text-sm text-content-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:text-content-primary mb-3 w-fit">
            <iconify-icon icon="solar:alt-arrow-left-bold-duotone" class="h-4 w-4"></iconify-icon>
            Quay lại danh sách loại phòng
        </a>
        <h2 class="text-3xl font-bold text-content-primary font-outfit tracking-tight">Chi Tiết Loại Phòng</h2>
        <p class="text-content-muted text-sm">Xem thông tin chi tiết và các thuộc tính của loại phòng này</p>
    </div>
    <div class="flex gap-3">
        <a asp-page="./Edit" asp-route-id="@Model.RoomType.Id" class="btn bg-primary hover:bg-primary/90 text-content-primary border-none px-6 rounded-xl shadow-lg shadow-primary/20 transition-all hover:scale-105 active:scale-95">
            <iconify-icon icon="solar:pen-new-square-bold-duotone" class="text-xl mr-2"></iconify-icon>
            Chỉnh sửa
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Cột trái: ảnh đại diện và mã loại phòng -->
    <div class="lg:col-span-5 flex flex-col gap-6">
        <div class="card bg-surface-2/30 border border-bdr-strong/50 shadow-2xl backdrop-blur-xl overflow-hidden rounded-3xl group">
            <div class="relative aspect-[3/2] overflow-hidden">
                @if (!string.IsNullOrEmpty(Model.RoomType.ImageUrl))
                {
                    <img src="@Model.RoomType.ImageUrl" alt="@Model.RoomType.Name" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex items-bottom p-8">
                        <div class="mt-auto">
                            <span class="badge bg-primary/20 backdrop-blur-md border border-primary/30 text-primary uppercase text-[10px] font-bold tracking-[0.2em] px-3 py-2">Premium Type</span>
                            <h3 class="text-2xl font-bold text-white mt-2">@Model.RoomType.Name</h3>
                        </div>
                    </div>
                }
                else
                {
                    <div class="w-full h-full bg-surface-1 flex flex-col items-center justify-center text-content-muted">
                        <iconify-icon icon="solar:gallery-bold-duotone" class="h-20 w-20 mb-4 opacity-50"></iconify-icon>
                        <span class="text-lg font-medium">Chưa có hình ảnh</span>
                    </div>
                }
            </div>
            
            <div class="p-6 bg-surface-2/50 border-t border-bdr-strong/30">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-content-muted font-mono uppercase tracking-widest">Mã loại phòng</span>
                    <span class="badge badge-outline border-bdr-strong text-content-primary font-mono px-4 py-3">RT-@Model.RoomType.Id.ToString("D3")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Cột phải: thông số giá, sức chứa, tiện nghi và mô tả -->
    <div class="lg:col-span-7">
        <div class="card bg-surface-2/30 border border-bdr-strong/50 shadow-2xl backdrop-blur-xl rounded-3xl h-full">
            <div class="card-body p-8 space-y-8">
                <!-- Khối thông số chính để đối chiếu nhanh -->
                <div class="grid grid-cols-2 gap-6 pb-8 border-b border-bdr-strong/30">
                    <div class="space-y-1">
                        <p class="text-xs text-content-muted uppercase tracking-widest font-bold">Giá Cơ Bản</p>
                        <div class="flex items-baseline gap-2">
                            <span class="text-4xl font-mono text-primary font-black">@Model.RoomType.BasePrice.ToString("N0")</span>
                            <span class="text-sm text-content-muted font-medium">VNĐ / đêm</span>
                        </div>
                    </div>
                    <div class="space-y-1">
                        <p class="text-xs text-content-muted uppercase tracking-widest font-bold">Sức Chứa</p>
                        <div class="flex items-center gap-3">
                            <div class="avatar-group -space-x-3 rtl:space-x-reverse">
                                @for(int i=0; i < Math.Min(Model.RoomType.MaxOccupancy, 3); i++){
                                    <div class="avatar h-10 w-10 border-2 border-surface-2 ring-0">
                                        <div class="bg-surface-3 flex items-center justify-center text-primary">
                                            <iconify-icon icon="solar:user-bold-duotone" class="text-xl"></iconify-icon>
                                        </div>
                                    </div>
                                }
                            </div>
                            <span class="text-2xl font-bold text-content-primary">@Model.RoomType.MaxOccupancy người</span>
                        </div>
                    </div>
                </div>

                <!-- Nội dung chi tiết tiện nghi và mô tả loại phòng -->
                <div class="space-y-6">
                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <iconify-icon icon="solar:list-bold-duotone" class="text-primary text-xl"></iconify-icon>
                            <h4 class="text-lg font-bold text-content-primary uppercase tracking-wider text-sm">Tiện Nghi Đi Kèm</h4>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            @if(!string.IsNullOrEmpty(Model.RoomType.Amenities)) {
                                @foreach(var amenity in Model.RoomType.Amenities.Split(',', StringSplitOptions.RemoveEmptyEntries)) {
                                    <span class="badge border-none bg-surface-3/50 text-content-secondary px-4 py-3 rounded-xl flex items-center gap-2">
                                        <iconify-icon icon="solar:check-circle-bold-duotone" class="text-primary"></iconify-icon>
                                        @amenity.Trim()
                                    </span>
                                }
                            } else {
                                <p class="text-content-muted italic text-sm">Không có danh sách tiện nghi</p>
                            }
                        </div>
                    </div>

                    <div>
                        <div class="flex items-center gap-2 mb-3">
                            <iconify-icon icon="solar:notes-bold-duotone" class="text-primary text-xl"></iconify-icon>
                            <h4 class="text-lg font-bold text-content-primary uppercase tracking-wider text-sm">Mô Tả Chi Tiết</h4>
                        </div>
                        <div class="bg-surface-1/30 rounded-2xl p-6 border border-bdr-strong/30 leading-relaxed text-content-secondary">
                             @(string.IsNullOrEmpty(Model.RoomType.Description) ? "Chưa có mô tả chi tiết cho loại phòng này." : Html.Raw(Model.RoomType.Description.Replace("\n", "<br/>")))
                        </div>
                    </div>
                </div>

                <!-- Phần cuối hiển thị thông tin cập nhật của trang -->
                <div class="mt-auto pt-8 flex items-center justify-between gap-4">
                    <p class="text-[10px] text-content-muted uppercase tracking-tighter">Cập nhật lần cuối: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</p>
                    <div class="h-1 flex-1 border-b border-dashed border-bdr-strong mx-4"></div>
                    <iconify-icon icon="solar:star-rainbow-bold-duotone" class="text-primary text-2xl opacity-50"></iconify-icon>
                </div>
            </div>
        </div>
    </div>
</div>
