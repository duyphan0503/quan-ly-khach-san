@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-6 bg-green-950/30 text-green-400 border border-green-500/30 backdrop-blur-sm rounded-xl py-3 px-4 flex items-center gap-3 animate-in fade-in slide-in-from-top-4 duration-500">
        <iconify-icon icon="solar:check-circle-bold-duotone" width="24" height="24"></iconify-icon>
        <span class="font-medium text-sm">@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-error mb-6 bg-red-950/30 text-red-300 border border-red-500/30 backdrop-blur-sm rounded-xl py-3 px-4 flex items-center gap-3 animate-in fade-in slide-in-from-top-4 duration-500">
        <iconify-icon icon="solar:close-circle-bold-duotone" width="24" height="24"></iconify-icon>
        <span class="font-medium text-sm">@TempData["ErrorMessage"]</span>
    </div>
}
