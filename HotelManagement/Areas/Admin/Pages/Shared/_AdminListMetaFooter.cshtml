@model HotelManagement.Areas.Admin.Pages.Shared.AdminListMetaFooterModel

<div class="mt-4 flex justify-end items-center text-[10px] text-content-muted uppercase tracking-widest px-4 opacity-50">
    <div class="flex items-center gap-4">
        <span class="flex items-center gap-1"><iconify-icon icon="solar:sort-from-top-to-bottom-bold-duotone" width="12" height="12" class="text-primary"></iconify-icon> Sắp xếp: @Model.SortText</span>
        <span class="flex items-center gap-1"><iconify-icon icon="solar:history-bold-duotone" width="12" height="12" class="text-primary"></iconify-icon> Cập nhật: @DateTime.Now.ToString("HH:mm:ss")</span>
    </div>
</div>
