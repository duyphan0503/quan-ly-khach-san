
@model HotelManagement.Areas.Admin.Pages.Shared.AdminPageHeaderModel
@{
    var headingClass = "text-3xl font-extrabold tracking-tight sm:text-4xl font-outfit uppercase bg-gradient-to-r from-content-primary via-primary to-accent bg-clip-text text-transparent drop-shadow-sm flex items-center gap-3";
}

<div class="@Model.WrapperClass">
    @if (string.Equals(Model.HeadingTag, "h2", StringComparison.OrdinalIgnoreCase))
    {
        <h2 class="@headingClass">
            <iconify-icon icon="@Model.Icon" class="text-primary drop-shadow-[0_0_10px_rgba(var(--primary-rgb),0.3)]"></iconify-icon>
            @Model.Title
        </h2>
    }
    else if (string.Equals(Model.HeadingTag, "h3", StringComparison.OrdinalIgnoreCase))
    {
        <h3 class="@headingClass">
            <iconify-icon icon="@Model.Icon" class="text-primary drop-shadow-[0_0_10px_rgba(var(--primary-rgb),0.3)]"></iconify-icon>
            @Model.Title
        </h3>
    }
    else
    {
        <h1 class="@headingClass">
            <iconify-icon icon="@Model.Icon" class="text-primary drop-shadow-[0_0_10px_rgba(var(--primary-rgb),0.3)]"></iconify-icon>
            @Model.Title
        </h1>
    }

    <div class="flex items-center gap-2">
        <span class="h-1 w-8 bg-primary rounded-full"></span>
        <p class="text-content-muted text-sm font-medium tracking-wide italic">@Model.Subtitle</p>
    </div>
</div>
