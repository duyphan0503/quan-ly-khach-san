@page "/admin/bookings"
@model HotelManagement.Areas.Admin.Pages.Bookings.IndexModel
@using HotelManagement.Core.Models.Enums
@{
    ViewData["Title"] = "Quản Lý Đặt Phòng";
}

<div class="mb-6 space-y-6">
    <partial name="~/Areas/Admin/Pages/Shared/_AdminPageHeader.cshtml" model='new HotelManagement.Areas.Admin.Pages.Shared.AdminPageHeaderModel
    {
        HeadingTag = "h2",
        Icon = "solar:calendar-mark-bold-duotone",
        Title = "Quản Lý Đặt Phòng",
        Subtitle = "Điều phối lượt lưu trú và tối ưu hóa trải nghiệm khách hàng"
    }' />

    <div class="w-full">
        <div class="flex w-full flex-wrap items-center gap-3">
            <form method="get" class="flex min-w-0 flex-wrap items-center gap-2">
            <div class="relative group">
                <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
                    <iconify-icon icon="solar:minimalistic-magnifer-linear" width="20" height="20" class="text-content-muted group-focus-within:text-primary transition-all duration-300"></iconify-icon>
                </div>
                <input type="text" name="Search" asp-for="Search" placeholder="Tìm khách, phòng, mã đặt phòng..."
                       class="input input-bordered bg-white/5 backdrop-blur-xl border-white/10 text-content-primary focus:border-primary/50 focus:ring-4 focus:ring-primary/10 pl-11 pr-4 w-80 transition-all rounded-2xl hover:bg-white/10 shadow-inner" />
            </div>

            <select name="Status" asp-for="Status" class="select bg-white/5 backdrop-blur-xl border-white/10 text-content-primary focus:border-primary/50 rounded-2xl min-w-[180px]">
                <option value="">Tất cả trạng thái</option>
                <option value="Pending">Chờ duyệt</option>
                <option value="Confirmed">Đã xác nhận</option>
                <option value="CheckedIn">Đã nhận phòng</option>
                <option value="CheckedOut">Đã trả phòng</option>
                <option value="Cancelled">Đã hủy</option>
            </select>

            <button type="submit" class="btn btn-square rounded-xl bg-primary/20 hover:bg-primary text-primary hover:text-white border border-primary/30 transition-all duration-300" title="Tìm kiếm và lọc" aria-label="Tìm kiếm và lọc">
                <iconify-icon icon="solar:filter-bold-duotone" width="18" height="18"></iconify-icon>
            </button>

            @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Status))
            {
                <a asp-page="./Index" class="btn btn-square rounded-xl border border-white/10 hover:border-red-400/40 hover:bg-red-500/10 text-content-muted hover:text-red-400 transition-all" title="Xóa bộ lọc" aria-label="Xóa bộ lọc">
                    <iconify-icon icon="solar:close-circle-bold-duotone" width="18" height="18"></iconify-icon>
                </a>
            }
            </form>

            <a asp-page="./Create" class="btn bg-gradient-to-br from-primary to-primary-700 hover:from-primary/90 hover:to-primary text-white border-none shadow-lg shadow-primary/20 hover:shadow-primary/40 hover:-translate-y-0.5 transition-all duration-300 rounded-2xl px-6 inline-flex items-center gap-2 shrink-0 md:ml-auto">
            <iconify-icon icon="solar:add-circle-bold-duotone" width="18" height="18"></iconify-icon>
            <span class="hidden sm:inline">Đặt Phòng Mới</span>
            <span class="sm:hidden">Thêm</span>
            </a>
        </div>
    </div>
</div>

<partial name="~/Areas/Admin/Pages/Shared/_AdminFlashMessages.cshtml" />

<div class="card bg-surface-2/40 backdrop-blur-xl border border-bdr-strong shadow-2xl rounded-2xl flex flex-col overflow-hidden">
    <div class="flex-grow overflow-x-auto">
        <table class="table w-full border-separate border-spacing-0 mq-row-fade">
            <thead>
                <tr class="text-content-muted uppercase text-[11px] tracking-[0.2em] font-black border-b border-white/5">
                    <th class="py-6 pl-8 text-left bg-surface-2/40 backdrop-blur-md first:rounded-tl-2xl">MÃ DP</th>
                    <th class="py-6 text-left bg-surface-2/40 backdrop-blur-md">KHÁCH HÀNG</th>
                    <th class="py-6 text-left bg-surface-2/40 backdrop-blur-md">PHÒNG</th>
                    <th class="py-6 text-left bg-surface-2/40 backdrop-blur-md">THỜI GIAN</th>
                    <th class="py-6 text-left bg-surface-2/40 backdrop-blur-md">TỔNG TIỀN</th>
                    <th class="py-6 text-center bg-surface-2/40 backdrop-blur-md">TRẠNG THÁI</th>
                    <th class="py-6 pr-8 text-right bg-surface-2/40 backdrop-blur-md last:rounded-tr-2xl">THAO TÁC</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-bdr-strong/30">
                <partial name="_BookingRows" model="Model.Bookings" />
                @if (!Model.Bookings.Any())
                {
                    <partial name="~/Areas/Admin/Pages/Shared/_AdminTableEmptyState.cshtml" model='new HotelManagement.Areas.Admin.Pages.Shared.AdminTableEmptyStateModel
                    {
                        ColSpan = 7,
                        Icon = "solar:calendar-search-bold-duotone",
                        Title = "Chưa có lịch đặt phòng phù hợp",
                        Description = "Không tìm thấy bản ghi đặt phòng theo từ khóa hoặc trạng thái hiện tại.",
                        CreatePage = "./Create",
                        CreateText = "Tạo Đặt Phòng Ngay"
                    }' />
                }
            </tbody>
        </table>
    </div>

    <partial name="~/Areas/Admin/Pages/Shared/_AdminPagination.cshtml" model='new HotelManagement.Areas.Admin.Pages.Shared.AdminPaginationModel
    {
        AspPage = "./Index",
        PageNumber = Model.PageNumber,
        TotalPages = Model.TotalPages,
        CurrentCount = Model.Bookings.Count,
        TotalCount = Model.TotalCount,
        ItemLabel = "đơn đặt phòng",
        RouteValues = new Dictionary<string, string?>
        {
            ["search"] = Model.Search,
            ["status"] = Model.Status
        }
    }' />
</div>

<partial name="~/Areas/Admin/Pages/Shared/_AdminListMetaFooter.cshtml" model='new HotelManagement.Areas.Admin.Pages.Shared.AdminListMetaFooterModel
{
    SortText = "Ưu tiên chờ duyệt"
}' />
