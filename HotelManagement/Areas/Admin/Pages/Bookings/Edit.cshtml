@page "/admin/bookings/edit/{id:int}"
@model HotelManagement.Areas.Admin.Pages.Bookings.EditModel
@using HotelManagement.Core.Models.Enums
@{
    ViewData["Title"] = "Điều chỉnh giao dịch";
}

<div class="px-4 py-8 max-w-5xl mx-auto min-h-screen">
    <!-- Header: Refined Luxury -->
    <div class="mb-12 flex flex-col items-center text-center space-y-4">
        <a asp-page="./Index" class="inline-flex items-center gap-2 rounded-xl border border-bdr-strong/70 bg-surface-2/70 px-3 py-2 text-sm text-content-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:text-content-primary mb-2">
            <iconify-icon icon="solar:alt-arrow-left-bold-duotone" class="h-4 w-4"></iconify-icon>
            <span>Quay lại danh sách đặt phòng</span>
        </a>
        
        <div class="space-y-3">
            <h1 class="text-5xl md:text-6xl font-luxury font-light text-content-primary tracking-wide leading-tight">
                Giao Dịch <span class="text-primary italic">#@Model.Booking.Id</span>
            </h1>
            <div class="flex items-center justify-center gap-4">
                <span class="h-px w-12 bg-bdr-strong"></span>
                <p class="text-content-muted font-sans text-xs tracking-[0.3em] uppercase">Mã tham chiếu điện tử — Minh Quang Luxury</p>
                <span class="h-px w-12 bg-bdr-strong"></span>
            </div>
        </div>
    </div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-error mb-8 rounded-none border-l-4 border-error bg-surface-2/50 backdrop-blur-md"></div>
        <input type="hidden" asp-for="Booking.Id" />
        <input type="hidden" asp-for="Booking.TotalAmount" />

        <div class="card bg-surface-2/30 border border-white/[0.03] shadow-2xl backdrop-blur-xl rounded-none p-8 lg:p-16 relative overflow-hidden group">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-20 gap-y-12 relative z-10">
                
                <!-- Section 1: Itinerary -->
                <div class="space-y-10">
                    <h2 class="text-3xl font-luxury text-content-primary border-b border-white/5 pb-6 flex items-center gap-4">
                        <iconify-icon icon="solar:route-linear" class="text-primary text-2xl"></iconify-icon>
                        Lịch trình trải nghiệm
                    </h2>

                    <div class="space-y-8">
                        <div class="grid grid-cols-2 gap-10">
                            <div class="relative group/field">
                                <label asp-for="Booking.CheckIn" class="block text-[10px] uppercase tracking-[0.2em] text-content-muted mb-3 font-sans font-bold group-focus-within/field:text-primary transition-colors">Ngày nhận phòng <span class="text-error">*</span></label>
                                <input asp-for="Booking.CheckIn" type="date" class="w-full bg-transparent border-b border-white/10 focus:border-primary py-4 px-0 text-content-primary font-sans transition-all outline-none text-xl" />
                                <span asp-validation-for="Booking.CheckIn" class="text-error text-[10px] mt-2 italic block tracking-wide"></span>
                            </div>
                            <div class="relative group/field">
                                <label asp-for="Booking.CheckOut" class="block text-[10px] uppercase tracking-[0.2em] text-content-muted mb-3 font-sans font-bold group-focus-within/field:text-primary transition-colors">Ngày trả phòng <span class="text-error">*</span></label>
                                <input asp-for="Booking.CheckOut" type="date" class="w-full bg-transparent border-b border-white/10 focus:border-primary py-4 px-0 text-content-primary font-sans transition-all outline-none text-xl" />
                                <span asp-validation-for="Booking.CheckOut" class="text-error text-[10px] mt-2 italic block tracking-wide"></span>
                            </div>
                        </div>

                        <div class="relative group/field">
                            <label asp-for="Booking.RoomId" class="block text-[10px] uppercase tracking-[0.2em] text-content-muted mb-3 font-sans font-bold group-focus-within/field:text-primary transition-colors">Không gian lưu trú <span class="text-error">*</span></label>
                            <select asp-for="Booking.RoomId" asp-items="Model.Rooms" class="w-full bg-transparent border-b border-white/10 focus:border-primary py-4 px-0 text-content-primary font-sans transition-all outline-none appearance-none cursor-pointer text-xl">
                                <option value="">-- Chọn không gian phòng --</option>
                            </select>
                            <div class="flex items-center gap-2 mt-4 text-xs font-serif italic text-primary">
                                <iconify-icon icon="solar:info-circle-linear"></iconify-icon>
                                <span>Lưu ý: Thay đổi phòng có thể ảnh hưởng đến tổng giá trị giao dịch.</span>
                            </div>
                            <span asp-validation-for="Booking.RoomId" class="text-error text-[10px] mt-2 italic block tracking-wide"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Guest Details -->
                <div class="space-y-10">
                    <h2 class="text-3xl font-luxury text-content-primary border-b border-white/5 pb-6 flex items-center gap-4">
                        <iconify-icon icon="solar:shield-user-linear" class="text-primary text-2xl"></iconify-icon>
                        Chủ thể giao dịch
                    </h2>

                    <div class="space-y-8">
                        <div class="relative group/field">
                            <label class="block text-[10px] uppercase tracking-[0.2em] text-content-muted mb-3 font-sans font-bold">Quý khách hàng</label>
                            <div class="w-full border-b border-white/5 py-4 text-content-primary font-luxury text-2xl tracking-wide">
                                @Model.Booking.Guest?.FullName
                            </div>
                            <input type="hidden" asp-for="Booking.GuestId" />
                        </div>

                        <div class="grid grid-cols-2 gap-10">
                            <div class="relative group/field">
                                <label asp-for="Booking.NumberOfGuests" class="block text-[10px] uppercase tracking-[0.2em] text-content-muted mb-3 font-sans font-bold group-focus-within/field:text-primary transition-colors">Số lượng quý khách <span class="text-error">*</span></label>
                                <input asp-for="Booking.NumberOfGuests" type="number" min="1" class="w-full bg-transparent border-b border-white/10 focus:border-primary py-4 px-0 text-content-primary font-sans transition-all outline-none text-xl" />
                                <span asp-validation-for="Booking.NumberOfGuests" class="text-error text-[10px] mt-2 italic block tracking-wide"></span>
                            </div>
                            <div class="relative group/field">
                                <label asp-for="Booking.Status" class="block text-[10px] uppercase tracking-[0.2em] text-content-muted mb-3 font-sans font-bold group-focus-within/field:text-primary transition-colors">Trạng thái giao dịch</label>
                                <select asp-for="Booking.Status" asp-items="Html.GetEnumSelectList<BookingStatus>()" class="w-full bg-transparent border-b border-white/10 focus:border-primary py-4 px-0 text-primary font-bold font-sans transition-all outline-none appearance-none cursor-pointer">
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Concierge Notes -->
                <div class="md:col-span-2 space-y-10">
                    <div class="relative group/field">
                        <label asp-for="Booking.Notes" class="block text-[10px] uppercase tracking-[0.2em] text-content-muted mb-3 font-sans font-bold group-focus-within/field:text-primary transition-colors">Yêu cầu Concierge đặc biệt</label>
                        <textarea asp-for="Booking.Notes" class="w-full bg-transparent border-b border-white/10 focus:border-primary py-4 px-0 text-content-primary font-sans transition-all outline-none text-xl h-24 resize-none placeholder:text-content-muted/20 scrollbar-hide" placeholder="Ghi chú các yêu cầu bổ sung về dịch vụ...">@Model.Booking.Notes</textarea>
                    </div>
                </div>
            </div>

            <!-- Total Amount Card -->
            <div class="mt-16 p-8 bg-primary/[0.03] border border-primary/10 flex flex-col md:flex-row justify-between items-center gap-6">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                        <iconify-icon icon="solar:gold-linear" class="text-2xl"></iconify-icon>
                    </div>
                    <div>
                        <p class="text-[10px] uppercase tracking-[0.2em] text-content-muted font-bold">Giá trị giao dịch dự kiến</p>
                        <p class="text-3xl font-luxury text-content-primary">@Model.Booking.TotalAmount.ToString("N0") <span class="text-sm">VND</span></p>
                    </div>
                </div>
                <div class="text-[10px] uppercase tracking-[0.1em] text-content-muted italic max-w-xs text-center md:text-right">
                    * Giá trị cuối cùng sẽ được tính dựa trên số ngày thực tế và các dịch vụ phát sinh tại quầy.
                </div>
            </div>

            <!-- Footer Actions -->
            <div class="mt-20 pt-10 border-t border-white/5 flex flex-col sm:flex-row justify-between items-center gap-8 relative z-10">
                <button type="submit" asp-page-handler="Delete" data-confirm-submit="Hủy giao dịch đặt phòng này? Quy trình hoàn tiền sẽ được áp dụng theo chính sách." class="group flex items-center gap-3 text-white/30 hover:text-error transition-all duration-500 py-3">
                    <iconify-icon icon="solar:trash-bin-minimalistic-linear" class="text-2xl group-hover:shake transition-all"></iconify-icon>
                    <span class="text-[10px] uppercase tracking-[0.3em] font-bold">Hủy giao dịch</span>
                </button>

                <div class="flex items-center gap-6 w-full sm:w-auto">
                    <a asp-page="./Index" class="group flex items-center bg-white/5 hover:bg-white/10 h-16 px-10 text-[10px] uppercase tracking-[0.3em] font-bold text-content-secondary transition-all flex-1 sm:flex-none justify-center">
                        Quay về
                    </a>
                    <button type="submit" class="group relative bg-primary hover:scale-[1.02] text-white h-16 px-16 transition-all duration-500 flex items-center justify-center gap-4 shadow-2xl shadow-primary/20 flex-1 sm:flex-none overflow-hidden">
                        <span class="relative z-10 text-[10px] uppercase tracking-[0.3em] font-bold">Xác nhận điều chỉnh</span>
                        <iconify-icon icon="solar:diskette-linear" class="relative z-10 text-2xl group-hover:scale-110 transition-transform"></iconify-icon>
                        <div class="absolute inset-0 bg-white/10 -translate-x-full group-hover:translate-x-0 transition-transform duration-1000"></div>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
