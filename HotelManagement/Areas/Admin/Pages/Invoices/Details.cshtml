@page "/admin/invoices/details/{id:int}"
@model HotelManagement.Areas.Admin.Pages.Invoices.DetailsModel
@using HotelManagement.Core.Models.Enums
@inject HotelManagement.Application.Services.Interfaces.IWebsiteSettingsService WebsiteSettingsService
@{
    var websiteSettings = await WebsiteSettingsService.GetCurrentAsync();
    var logoUrl = string.IsNullOrWhiteSpace(websiteSettings.LogoUrl) ? "/images/logo.svg" : websiteSettings.LogoUrl;
    var brandFullName = string.IsNullOrWhiteSpace(websiteSettings.BrandFullName) ? "Khách Sạn Minh Quang Luxury" : websiteSettings.BrandFullName;
    var contactAddress = string.IsNullOrWhiteSpace(websiteSettings.ContactAddress) ? "123 Đường Tôn Đức Thắng, Quận Ninh Kiều, Cần Thơ" : websiteSettings.ContactAddress;
    var contactPhone = string.IsNullOrWhiteSpace(websiteSettings.ContactPhone) ? "0123.456.789" : websiteSettings.ContactPhone;
    var contactEmail = string.IsNullOrWhiteSpace(websiteSettings.ContactEmail) ? "contact@minhquang.vn" : websiteSettings.ContactEmail;

    ViewData["Title"] = "Chi Tiết Hóa Đơn";
    // Chúng ta định nghĩa class in invoice rieng de khi an Ctrl P nó an Sidebar v.v...
}

<div class="mb-8 grid grid-cols-1 gap-4 print:hidden xl:grid-cols-[1fr_auto_1fr] xl:items-center">
    <div class="flex justify-center xl:justify-self-start xl:justify-start">
        <a asp-page="./Index" class="inline-flex w-fit items-center gap-2 rounded-xl border border-bdr-strong/70 bg-surface-2/70 px-3 py-2 text-sm text-content-muted transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:text-content-primary">
            <iconify-icon icon="solar:alt-arrow-left-bold-duotone" class="h-4 w-4"></iconify-icon>
            <span>Quay lại danh sách hóa đơn</span>
        </a>
    </div>

    <div class="text-center xl:justify-self-center">
        <h2 class="text-3xl font-bold text-content-primary font-outfit tracking-tight">Chi Tiết Hóa Đơn</h2>
        <p class="text-content-muted mt-1">Hóa đơn số <span class="text-primary font-bold">#@Model.Invoice.InvoiceNumber</span></p>
    </div>

    <div class="flex justify-center gap-2 xl:justify-self-end xl:justify-end">
        @if (Model.Invoice.InvoiceDetails.Count > 1 && Model.Invoice.Status == InvoiceStatus.Pending)
        {
            <a asp-page="./Split" asp-route-id="@Model.Invoice.Id" class="btn bg-accent/20 hover:bg-accent text-accent hover:text-white border border-accent/30 shadow-lg shadow-accent/10 hover:shadow-accent/30 hover:-translate-y-0.5 transition-all duration-300">
                <iconify-icon icon="solar:documents-bold-duotone" class="h-5 w-5 mr-1"></iconify-icon>
                Tách Chứng Từ
            </a>
        }
        <button type="button" data-print-page class="btn bg-primary hover:bg-primary/90 text-content-primary border-none shadow-lg shadow-primary/20 hover:shadow-primary/40 hover:-translate-y-0.5 transition-all duration-300">
            <iconify-icon icon="solar:printer-bold-duotone" class="h-5 w-5 mr-1"></iconify-icon>
            In Hóa Đơn
        </button>
    </div>
</div>

<div id="invoice-print-area" class="card bg-surface-1 text-content-primary shadow-xl max-w-4xl mx-auto print:shadow-none print:max-w-full backdrop-blur-md">
    <div class="card-body p-10 print:p-0">
        <!-- Header Hóa Đơn -->
        <div class="flex justify-between items-start border-b-2 border-bdr-strong pb-8 mb-8">
            <div>
                <div class="mb-4">
                    <img src="@logoUrl" alt="@($"{brandFullName} Logo")" class="h-16 w-auto" />
                </div>
                <h1 class="text-4xl font-bold text-primary font-outfit tracking-tighter mb-2">HÓA ĐƠN</h1>
                <p class="text-content-muted font-bold mb-1">@brandFullName</p>
                <p class="text-content-muted text-sm">@contactAddress</p>
                <p class="text-content-muted text-sm">SĐT: @contactPhone | Email: @contactEmail</p>
            </div>
            <div class="text-right">
                <div class="text-2xl font-bold text-content-secondary tracking-tight">#@Model.Invoice.InvoiceNumber</div>
                <div class="text-content-muted mt-2">Ngày lập: <span class="font-medium text-content-secondary">@Model.Invoice.InvoiceDate.ToString("dd/MM/yyyy")</span></div>
                <div class="text-content-muted">Thu ngân: <span class="font-medium text-content-secondary">@Model.Invoice.CreatedByUser?.FullName</span></div>
                <div class="mt-4">
                    @if (Model.Invoice.Status == InvoiceStatus.Paid)
                    {
                        <span class="inline-block px-4 py-1 rounded-full bg-success/20 text-success font-bold border border-success text-sm">ĐÃ THANH TOÁN</span>
                    }
                    else
                    {
                        <span class="inline-block px-4 py-1 rounded-full bg-warning/20 text-warning font-bold border border-warning text-sm">CHƯA THANH TOÁN</span>
                    }
                </div>
            </div>
        </div>

        <!-- Thông tin Khách & Phòng -->
        <div class="grid grid-cols-2 gap-8 mb-8">
            <div>
                <h3 class="text-sm font-bold text-content-muted uppercase tracking-widest mb-2">Thanh Toán Cho</h3>
                <div class="flex items-center gap-4 mb-2">
                    <div class="w-12 h-12 rounded-full bg-surface-3 flex items-center justify-center text-lg text-primary border border-primary/20 overflow-hidden shrink-0 shadow-lg print:hidden">
                        @{
                            var normalizedAvatarUrl = HotelManagement.Helpers.AvatarUrlHelper.Normalize(Model.Invoice.Booking.Guest?.AvatarUrl);
                        }
                        @if (!string.IsNullOrEmpty(normalizedAvatarUrl))
                        {
                            <img src="@normalizedAvatarUrl" alt="Avatar" class="w-full h-full object-cover" data-avatar-image data-avatar-fallback="#invoice-details-avatar-fallback" />
                            <span id="invoice-details-avatar-fallback" class="mq-avatar-fallback-block">@(Model.Invoice.Booking.Guest?.FullName?.FirstOrDefault('G') ?? 'G')</span>
                        }
                        else
                        {
                            <span>@(Model.Invoice.Booking.Guest?.FullName?.FirstOrDefault('G') ?? 'G')</span>
                        }
                    </div>
                    <div>
                        <p class="text-lg font-bold text-primary">@Model.Invoice.Booking.Guest?.FullName</p>
                        <p class="text-content-muted text-sm">SĐT: @Model.Invoice.Booking.Guest?.PhoneNumber</p>
                    </div>
                </div>
                <p class="text-content-muted">CCCD/Passport: @Model.Invoice.Booking.Guest?.CCCD</p>
            </div>
            <div class="text-right">
                <h3 class="text-sm font-bold text-content-muted uppercase tracking-widest mb-2">Chi Tiết Lưu Trú</h3>
                <p class="text-content-muted">Phòng: <span class="font-bold text-primary">@Model.Invoice.Booking.Room.RoomNumber</span> (@Model.Invoice.Booking.Room.RoomType.Name)</p>
                <p class="text-content-muted">Check-in: @Model.Invoice.Booking.CheckIn.ToString("dd/MM/yyyy")</p>
                <p class="text-content-muted">Check-out: @Model.Invoice.Booking.CheckOut.ToString("dd/MM/yyyy")</p>
            </div>
        </div>

        <!-- Bảng Dịch Vụ -->
        <div class="mb-8">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-y-2 border-bdr-strong text-content-muted font-bold">
                        <th class="py-3 px-2">Mô tả</th>
                        <th class="py-3 px-2 text-center">Số lượng</th>
                        <th class="py-3 px-2 text-right">Đơn giá (VNĐ)</th>
                        <th class="py-3 px-2 text-right">Thành tiền (VNĐ)</th>
                    </tr>
                </thead>
                <tbody class="text-content-secondary">
                    @foreach (var detail in Model.Invoice.InvoiceDetails)
                    {
                        <tr class="border-b border-bdr-default">
                            <td class="py-3 px-2">@detail.Description</td>
                            <td class="py-3 px-2 text-center">@detail.Quantity</td>
                            <td class="py-3 px-2 text-right font-mono">@detail.UnitPrice.ToString("N0")</td>
                            <td class="py-3 px-2 text-right font-mono font-medium">@detail.LineTotal.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Tổng Kết -->
        <div class="flex justify-end">
            <div class="w-1/2 space-y-3">
                <div class="flex justify-between text-content-muted">
                    <span>Cộng tiền hàng:</span>
                    <span class="font-mono font-medium">@Model.Invoice.SubTotal.ToString("N0") ₫</span>
                </div>
                <div class="flex justify-between text-content-muted">
                    <span>Thuế / Phụ thu:</span>
                    <span class="font-mono font-medium text-warning">+@Model.Invoice.Tax.ToString("N0") ₫</span>
                </div>
                <div class="flex justify-between text-content-muted">
                    <span>Giảm giá:</span>
                    <span class="font-mono font-medium text-success">-@Model.Invoice.Discount.ToString("N0") ₫</span>
                </div>
                <div class="flex justify-between text-primary border-t-2 border-bdr-strong pt-3 mt-3">
                    <span class="font-bold text-xl uppercase">Tổng Cộng:</span>
                    <span class="font-mono font-black text-2xl tracking-tighter">@Model.Invoice.GrandTotal.ToString("N0") ₫</span>
                </div>
                <div class="flex justify-between text-content-muted text-sm pt-2">
                    <span>Hình thức thanh toán:</span>
                    <span class="font-bold">
                        @(Model.Invoice.PaymentMethod switch {
                            PaymentMethod.Cash => "Tiền mặt",
                            PaymentMethod.Card => "Thẻ ngân hàng",
                            PaymentMethod.Transfer => "Chuyển khoản",
                            _ => Model.Invoice.PaymentMethod.ToString()
                        })
                    </span>
                </div>
            </div>
        </div>

        <!-- Footer Note -->
        <div class="mt-16 pt-8 border-t border-bdr-strong text-center text-content-muted text-sm">
            <p class="font-medium text-content-muted mb-1">Cảm ơn quý khách đã sử dụng dịch vụ của khách sạn chúng tôi.</p>
            <p>Hẹn gặp lại quý khách trong lần tới!</p>
        </div>

    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/pages/admin/invoices/details.css" asp-append-version="true" />
}
