@page "/rooms"
@model HotelManagement.Areas.Public.Pages.Rooms.IndexModel
@{
    ViewData["Title"] = "Danh Sách Phòng Tốt Nhất";

    string GetRoomTypeClass(string? name)
    {
        if (string.IsNullOrEmpty(name)) return "bg-slate-500/10 text-slate-400 border-white/5";
        var lower = name.ToLower();
        if (lower.Contains("suite")) return "bg-emerald-500/20 text-emerald-400 border-emerald-500/30";
        if (lower.Contains("deluxe")) return "bg-blue-500/20 text-blue-400 border-blue-500/30";
        if (lower.Contains("vip") || lower.Contains("luxury") || lower.Contains("president")) return "bg-accent/20 text-accent border-accent/40";
        return "bg-slate-500/20 text-slate-300 border-white/10";
    }
}

<div class="pt-16 pb-12 bg-surface-1 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Tiêu đề trang danh sách phòng theo nhu cầu lưu trú -->
        <div class="text-center mb-16">
            <h2 class="text-accent tracking-[0.2em] uppercase text-sm font-semibold mb-4">Lựa chọn của bạn</h2>
            <h1 class="text-4xl md:text-5xl font-outfit font-extrabold text-content-primary">Khám Phá Không Gian Nghỉ Dưỡng</h1>
        </div>

        <!-- Thanh lọc theo ngày, loại phòng và số lượng khách -->
        <div class="bg-surface-2/30 backdrop-blur-2xl border border-white/5 p-8 mb-20 animate-fade-in rounded-[2rem] shadow-[0_32px_64px_-16px_rgba(0,0,0,0.6)] relative overflow-hidden group">
            <div class="absolute inset-0 bg-gradient-to-br from-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>
            <form method="get" class="relative z-10 grid grid-cols-1 md:grid-cols-4 gap-8 items-end">
                <div class="form-control w-full">
                    <label class="label mb-1"><span class="label-text text-white/50 uppercase tracking-[0.2em] text-[10px] font-bold ml-1">Ngày Nhận</span></label>
                    <div class="relative">
                        <iconify-icon icon="solar:calendar-mark-bold-duotone" class="absolute left-4 top-1/2 -translate-y-1/2 text-accent text-xl"></iconify-icon>
                        <input name="CheckIn" type="date" class="input bg-surface-1/40 border border-white/5 text-content-primary w-full pl-12 h-14 focus:border-accent/50 focus:ring-4 focus:ring-accent/10 rounded-2xl transition-all shadow-inner" value="@(Model.CheckIn?.ToString("yyyy-MM-dd") ?? DateTime.Today.ToString("yyyy-MM-dd"))" />
                    </div>
                </div>
                <div class="form-control w-full">
                    <label class="label mb-1"><span class="label-text text-white/50 uppercase tracking-[0.2em] text-[10px] font-bold ml-1">Ngày Trả</span></label>
                    <div class="relative">
                        <iconify-icon icon="solar:calendar-send-bold-duotone" class="absolute left-4 top-1/2 -translate-y-1/2 text-accent text-xl"></iconify-icon>
                        <input name="CheckOut" type="date" class="input bg-surface-1/40 border border-white/5 text-content-primary w-full pl-12 h-14 focus:border-accent/50 focus:ring-4 focus:ring-accent/10 rounded-2xl transition-all shadow-inner" value="@(Model.CheckOut?.ToString("yyyy-MM-dd") ?? DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))" />
                    </div>
                </div>
                <div class="form-control w-full">
                    <label class="label mb-1"><span class="label-text text-white/50 uppercase tracking-[0.2em] text-[10px] font-bold ml-1">Loại Phòng</span></label>
                    <div class="relative">
                        <iconify-icon icon="solar:bed-bold-duotone" class="absolute left-4 top-1/2 -translate-y-1/2 text-accent text-xl"></iconify-icon>
                        <select asp-for="RoomTypeFilter" class="select bg-surface-1/40 border border-white/5 text-content-primary w-full pl-12 h-14 focus:border-accent/50 focus:ring-4 focus:ring-accent/10 rounded-2xl transition-all appearance-none shadow-inner">
                            <option value="">Tất cả loại phòng</option>
                            @foreach (var type in Model.RoomTypes)
                            {
                                <option value="@type.Name" class="bg-surface-2 text-content-primary">@type.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="flex gap-4 items-end">
                    <div class="form-control grow">
                        <label class="label mb-1"><span class="label-text text-white/50 uppercase tracking-[0.2em] text-[10px] font-bold ml-1">Khách</span></label>
                        <div class="relative">
                            <iconify-icon icon="solar:users-group-rounded-bold-duotone" class="absolute left-4 top-1/2 -translate-y-1/2 text-accent text-xl"></iconify-icon>
                            <input asp-for="Guests" type="number" min="1" max="10" class="input bg-surface-1/40 border border-white/5 text-content-primary w-full pl-12 h-14 focus:border-accent/50 focus:ring-4 focus:ring-accent/10 rounded-2xl transition-all shadow-inner" />
                        </div>
                    </div>
                    <button type="submit" class="btn bg-accent hover:bg-accent-soft text-brand border-none px-10 font-outfit font-black uppercase tracking-[0.15em] text-[11px] h-14 rounded-2xl shadow-xl shadow-accent/20 transition-all hover:-translate-y-1 active:scale-95 active:translate-y-0 flex items-center gap-2">
                        <iconify-icon icon="solar:filter-bold-duotone" class="text-lg"></iconify-icon>
                        Lọc
                    </button>
                </div>
            </form>
            <div class="mt-6 relative z-10 px-1">
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/5 border border-white/5 text-xs text-content-muted">
                    <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse"></span>
                    Hiển thị <span class="text-accent font-bold">@Model.AvailableRooms.Count</span> kết quả phù hợp cho hành trình của bạn.
                </span>
            </div>
        </div>

        <!-- Lưới hiển thị phòng khả dụng theo bộ lọc hiện tại -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @foreach (var room in Model.AvailableRooms)
            {
                var imgUrl = room.ImageUrl ?? room.RoomType?.ImageUrl ?? "/images/room_standard.jpg";
                var webpUrl = imgUrl.EndsWith(".jpg") ? imgUrl.Replace(".jpg", ".webp") : imgUrl;
                
                <div class="group bg-surface-2/40 backdrop-blur-xl border border-white/5 hover:border-accent/40 transition-all duration-500 flex flex-col rounded-[2rem] overflow-hidden shadow-2xl relative">
                    <div class="h-60 overflow-hidden relative">
                        <picture>
                            <source srcset="@webpUrl" type="image/webp">
                            <img src="@imgUrl" 
                                 width="600" height="400"
                                 loading="lazy"
                                 class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-1000 filter brightness-90 group-hover:brightness-100" 
                                 alt="Room @room.RoomNumber" />
                        </picture>
                        <div class="absolute top-5 left-5">
                            @if (room.Status == HotelManagement.Core.Models.Enums.RoomStatus.Available)
                            {
                                <div class="flex items-center gap-2 px-3 py-1.5 bg-black/50 backdrop-blur-md rounded-lg border border-white/10 shadow-xl">
                                    <span class="relative flex h-2 w-2">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-success opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-2 w-2 bg-success"></span>
                                    </span>
                                    <span class="text-[10px] font-bold text-white/90 uppercase tracking-widest font-inter">Phòng trống</span>
                                </div>
                            }
                            else
                            {
                                <div class="flex items-center gap-2 px-3 py-1.5 bg-black/60 backdrop-blur-md rounded-lg border border-danger/20 shadow-xl text-danger">
                                    <iconify-icon icon="solar:lock-bold-duotone" class="text-xs"></iconify-icon>
                                    <span class="text-[10px] font-bold uppercase tracking-widest font-inter">Đã đặt / Bận</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="p-6 grow flex flex-col relative text-left">
                        <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
                        <div class="flex justify-between items-start mb-3">
                            <h3 class="text-2xl font-bold text-content-primary font-outfit tracking-tight">Phòng @room.RoomNumber</h3>
                            <span class="badge @GetRoomTypeClass(room.RoomType?.Name) border-none px-3 py-2.5 font-bold uppercase text-[8px] tracking-widest shadow-[0_5px_15px_rgba(0,0,0,0.3)]">
                                @room.RoomType?.Name
                            </span>
                        </div>
                        <div class="flex justify-between items-end mb-6">
                            <p class="text-accent-soft font-mono font-bold text-xl">
                                @room.RoomType?.BasePrice.ToString("N0") <span class="text-[10px] font-outfit text-white/30 uppercase tracking-widest ml-1">VNĐ / Đêm</span>
                            </p>
                            <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-white/5 border border-white/5">
                                <iconify-icon icon="solar:users-group-rounded-bold-duotone" class="text-accent text-sm"></iconify-icon>
                                <span class="text-[10px] font-bold text-white/60 uppercase tracking-tight">Tối đa @(room.RoomType?.MaxOccupancy) người</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(room.RoomType?.Amenities))
                        {
                            <div class="flex flex-wrap gap-1.5 mb-8">
                                @foreach (var amenity in room.RoomType.Amenities.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-white/5 border border-white/5 text-[9px] font-medium uppercase tracking-widest text-white/40">
                                        @amenity.Trim()
                                    </span>
                                }
                            </div>
                        }
                        
                        <div class="mt-auto pt-6 border-t border-white/5 flex gap-3">
                            <a asp-page="./Details" 
                               asp-route-id="@room.Id" 
                               class="btn grow bg-white/10 hover:bg-white/20 text-white/90 border-white/5 transition-all font-outfit font-bold uppercase tracking-widest text-[10px] h-12 rounded-xl">
                                Chi Tiết
                            </a>
                            @if (room.Status == HotelManagement.Core.Models.Enums.RoomStatus.Available)
                            {
                                <a asp-page="/Booking/Request" 
                                   asp-route-roomId="@room.Id" 
                                   asp-route-checkIn="@Model.CheckIn?.ToString("yyyy-MM-dd")"
                                   asp-route-checkOut="@Model.CheckOut?.ToString("yyyy-MM-dd")"
                                   asp-route-guests="@Model.Guests"
                                   class="btn grow bg-accent hover:bg-accent-soft text-brand border-none transition-all font-outfit font-black uppercase tracking-widest text-[10px] h-12 rounded-xl shadow-lg shadow-accent/5">
                                    Đặt Ngay
                                </a>
                            }
                            else
                            {
                                <button class="btn grow bg-white/5 text-white/10 border-white/5 cursor-not-allowed font-outfit uppercase tracking-widest text-[10px] h-12 rounded-xl" disabled>
                                    Hết Phòng
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (!Model.AvailableRooms.Any())
        {
            <div class="text-center py-20">
                <div class="text-6xl mb-4 text-content-muted"><iconify-icon icon="fluent-emoji-flat:inbox-tray"></iconify-icon></div>
                <h3 class="text-xl text-content-primary font-medium mb-2">Không tìm thấy phòng trống</h3>
                <p class="text-content-muted">Xin lỗi, hiện tại không có phòng nào phù hợp với tiêu chí lọc của bạn.</p>
                <a asp-page="./Index" class="btn btn-outline border-bdr-strong text-content-secondary mt-6">Xem tất cả phòng</a>
            </div>
        }

    </div>
</div>
