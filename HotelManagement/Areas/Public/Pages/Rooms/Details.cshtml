@page "/rooms/{id:int}"
@model HotelManagement.Areas.Public.Pages.Rooms.DetailsModel
@inject HotelManagement.Application.Services.Interfaces.IWebsiteSettingsService WebsiteSettingsService
@{
    var websiteSettings = await WebsiteSettingsService.GetCurrentAsync();
    var contactPhone = string.IsNullOrWhiteSpace(websiteSettings.ContactPhone) ? "+84 123 456 789" : websiteSettings.ContactPhone;
    var contactEmail = string.IsNullOrWhiteSpace(websiteSettings.ContactEmail) ? "support@minhquang.vn" : websiteSettings.ContactEmail;
    var contactTel = new string(contactPhone.Where(char.IsDigit).ToArray());
    if (!contactTel.StartsWith("+" , StringComparison.Ordinal) && contactPhone.TrimStart().StartsWith("+", StringComparison.Ordinal))
    {
        contactTel = "+" + contactTel;
    }

    ViewData["Title"] = $"Phòng {Model.Room.RoomNumber} - {Model.Room.RoomType?.Name}";
}

<div class="pt-16 pb-24 bg-surface-1 min-h-screen relative overflow-hidden">
    <!-- Lớp nền trang trí để tăng chiều sâu khối nội dung -->
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/5 rounded-full blur-[120px] -z-10 translate-x-1/2 -translate-y-1/2"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-accent/5 rounded-full blur-[120px] -z-10 -translate-x-1/2 translate-y-1/2"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Điều hướng phân cấp giúp người dùng định vị trang hiện tại -->
        <nav class="flex mb-8 text-sm font-medium tracking-wide uppercase" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a asp-page="/Index" class="text-content-muted hover:text-accent transition-colors flex items-center gap-1">
                        <iconify-icon icon="solar:home-2-bold-duotone"></iconify-icon> Trang Chủ
                    </a>
                </li>
                <li>
                    <div class="flex items-center">
                        <iconify-icon icon="solar:alt-arrow-right-linear" class="text-content-muted mx-2"></iconify-icon>
                        <a asp-page="./Index" class="text-content-muted hover:text-accent transition-colors">Danh Sách Phòng</a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <iconify-icon icon="solar:alt-arrow-right-linear" class="text-content-muted mx-2"></iconify-icon>
                        <span class="text-content-primary">Chi Tiết Phòng @Model.Room.RoomNumber</span>
                    </div>
                </li>
            </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
            
            <!-- Cột trái: hình ảnh phòng và tiện nghi nổi bật -->
            <div class="lg:col-span-2 space-y-10">
                
                <!-- Ảnh chính của phòng để người dùng đánh giá nhanh không gian -->
                <div class="group relative aspect-video overflow-hidden rounded-3xl border border-bdr-strong/50 shadow-2xl">
                    @{
                        var detailImgUrl = Model.Room.ImageUrl ?? Model.Room.RoomType?.ImageUrl ?? "/images/room_standard.jpg";
                        var detailWebpUrl = detailImgUrl.EndsWith(".jpg") ? detailImgUrl.Replace(".jpg", ".webp") : detailImgUrl;
                    }
                    <picture>
                        <source srcset="@detailWebpUrl" type="image/webp">
                        <img src="@detailImgUrl" 
                             width="1200" height="675"
                             fetchpriority="high"
                             loading="eager"
                             alt="Room @Model.Room.RoomNumber" 
                             class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                    </picture>
                    <div class="absolute inset-0 bg-linear-to-t from-surface-1/60 to-transparent"></div>
                    <div class="absolute bottom-8 left-8">
                        <span class="badge bg-accent text-brand-900 border-none px-4 py-3 font-bold uppercase tracking-widest text-[10px] mb-3">@(Model.Room.RoomType?.Name)</span>
                        <h1 class="text-4xl md:text-5xl font-outfit font-extrabold text-white tracking-tighter">Phòng @Model.Room.RoomNumber</h1>
                    </div>
                </div>

                <!-- Danh sách tiện nghi để hỗ trợ quyết định đặt phòng -->
                <div class="bg-surface-2/40 backdrop-blur-xl rounded-3xl p-10 border border-bdr-strong/50">
                    <h3 class="text-2xl font-outfit font-bold text-content-primary mb-8 flex items-center gap-3">
                        <iconify-icon icon="solar:stars-minimalistic-bold-duotone" class="text-accent text-3xl"></iconify-icon>
                        Tiện Nghi Cao Cấp
                    </h3>
                    
                    <div class="grid grid-cols-2 md:grid-cols-3 gap-y-10 gap-x-6">
                        <!-- Thông tin sức chứa: yếu tố nghiệp vụ quan trọng khi lọc phòng -->
                        <div class="flex items-center gap-5 group/item p-4 rounded-2xl bg-accent/5 border border-accent/10 hover:bg-accent/10 transition-all duration-300">
                            <div class="w-12 h-12 rounded-xl bg-accent/20 flex items-center justify-center text-accent group-hover/item:scale-110 transition-transform">
                                <iconify-icon icon="solar:users-group-rounded-bold-duotone" class="text-2xl"></iconify-icon>
                            </div>
                            <div class="flex flex-col">
                                <span class="text-[10px] font-bold text-accent/60 uppercase tracking-tighter mb-0.5">Sức chứa</span>
                                <span class="text-[13px] font-bold text-white uppercase tracking-widest font-inter">Tối đa @(Model.Room.RoomType?.MaxOccupancy) người</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Room.RoomType?.Amenities))
                        {
                            foreach (var item in Model.Room.RoomType.Amenities.Split(',', StringSplitOptions.RemoveEmptyEntries))
                            {
                                <div class="flex items-center gap-5 group/item p-4 rounded-2xl bg-white/[0.03] border border-white/5 hover:bg-white/[0.08] transition-all duration-300">
                                    <div class="w-12 h-12 rounded-xl bg-accent/10 flex items-center justify-center text-accent group-hover/item:scale-110 transition-transform">
                                        <iconify-icon icon="solar:verified-check-bold-duotone" class="text-2xl"></iconify-icon>
                                    </div>
                                    <span class="text-[12px] font-semibold text-white/90 uppercase tracking-widest font-inter">@item.Trim()</span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-content-muted italic col-span-full">Thông tin tiện nghi đang được cập nhật...</p>
                        }
                    </div>
                </div>

            </div>

            <!-- Cột phải: thông tin giá, mô tả và CTA đặt phòng -->
            <div class="space-y-8">
                
                <!-- Thẻ giá và chính sách ngắn gọn cho chuyển đổi đặt phòng -->
                <div class="bg-surface-2 border border-bdr-strong/50 rounded-3xl p-8 shadow-2xl">
                    <p class="text-[10px] uppercase tracking-[0.2em] text-white/40 font-bold mb-3">Giá chỉ từ</p>
                    <div class="flex items-baseline gap-2 mb-10">
                        <span class="text-5xl font-outfit font-black text-accent tracking-tighter">@Model.Room.RoomType?.BasePrice.ToString("N0")</span>
                        <span class="text-white/30 font-bold text-xs uppercase tracking-widest">VNĐ / Đêm</span>
                    </div>

                    <div class="space-y-5 mb-10">
                        <div class="flex items-center gap-3 text-sm text-white/70">
                            <iconify-icon icon="solar:check-circle-bold-duotone" class="text-success text-xl"></iconify-icon>
                            <span class="font-medium">Miễn phí bữa sáng Buffet</span>
                        </div>
                        <div class="flex items-center gap-3 text-sm text-white/70">
                            <iconify-icon icon="solar:check-circle-bold-duotone" class="text-success text-xl"></iconify-icon>
                            <span class="font-medium">Hỗ trợ nhận phòng sớm</span>
                        </div>
                        <div class="flex items-center gap-3 text-sm text-white/70">
                            <iconify-icon icon="solar:check-circle-bold-duotone" class="text-success text-xl"></iconify-icon>
                            <span class="font-medium">Hủy phòng miễn phí trước 24h</span>
                        </div>
                    </div>

                    <a asp-page="/Booking/Request" 
                       asp-route-roomId="@Model.Room.Id" 
                       asp-route-checkIn="@Model.CheckIn?.ToString("yyyy-MM-dd")"
                       asp-route-checkOut="@Model.CheckOut?.ToString("yyyy-MM-dd")"
                       asp-route-guests="@Model.Guests"
                       class="btn bg-accent hover:bg-accent-soft text-brand border-none w-full h-16 rounded-2xl font-outfit font-black uppercase tracking-[0.2em] text-xs shadow-[0_20px_40px_-10px_rgba(205,168,115,0.4)] hover:-translate-y-1 transition-all active:scale-95 active:translate-y-0 text-center flex items-center justify-center">
                        Đặt Phòng Ngay
                    </a>

                    <p class="text-center text-[11px] text-content-muted mt-6 italic">
                        * Giá trên chưa bao gồm thuế và phí dịch vụ.
                    </p>
                </div>

                <!-- Mô tả chi tiết bổ sung để làm rõ trải nghiệm lưu trú -->
                <div class="bg-surface-2/30 backdrop-blur-md border border-white/5 rounded-3xl p-8">
                    <h3 class="text-xl font-outfit font-bold text-white/95 mb-6 tracking-tight flex items-center gap-2">
                        <iconify-icon icon="solar:notes-bold-duotone" class="text-accent"></iconify-icon>
                        Mô Tả Chi Tiết
                    </h3>
                    <div class="space-y-4">
                        <p class="text-white/50 leading-relaxed text-sm font-light">
                            @Model.Room.RoomType?.Description
                        </p>
                        <p class="text-white/50 leading-relaxed text-sm font-light">
                            Tại Minh Quang Luxury Hotel, chúng tôi tin rằng sự sang trọng thực sự nằm ở những chi tiết nhỏ nhất. 
                            Phòng @Model.Room.RoomNumber được thiết kế để mang lại cảm giác bình yên tuyệt đối.
                        </p>
                    </div>
                </div>

                <!-- Khối hỗ trợ nhanh khi khách cần tư vấn trực tiếp -->
                <div class="bg-surface-3/30 border border-bdr-default rounded-2xl p-6">
                    <h4 class="text-content-primary font-bold mb-4">Cần hỗ trợ?</h4>
                    <div class="space-y-3">
                        <a href="tel:@contactTel" class="flex items-center gap-3 text-sm text-content-secondary hover:text-accent transition-colors">
                            <iconify-icon icon="solar:phone-bold-duotone" class="text-lg"></iconify-icon>
                            @contactPhone
                        </a>
                        <a href="mailto:@contactEmail" class="flex items-center gap-3 text-sm text-content-secondary hover:text-accent transition-colors">
                            <iconify-icon icon="solar:letter-bold-duotone" class="text-lg"></iconify-icon>
                            @contactEmail
                        </a>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
