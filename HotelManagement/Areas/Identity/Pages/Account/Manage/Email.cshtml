@page
@model EmailModel
@{
    ViewData["Title"] = "Cài đặt Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
    Layout = "_Layout.cshtml";
}

<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post" class="space-y-8 animate-fade-in">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-error bg-danger/10 border-danger/20 text-danger text-sm p-3 rounded-3xl mb-8" role="alert"></div>
    }

    <div class="space-y-8">
        <!-- Current Email -->
        <div class="space-y-3 text-left">
            <label asp-for="Email" class="text-[10px] font-bold uppercase tracking-[0.2em] text-content-muted ml-2">Email hiện tại</label>
            <div class="relative group">
                <span class="absolute inset-y-0 left-0 pl-5 flex items-center text-content-muted opacity-50">
                    <iconify-icon icon="solar:letter-bold-duotone" class="text-2xl"></iconify-icon>
                </span>
                <input asp-for="Email" class="w-full bg-surface-3/50 border border-white/5 rounded-2xl py-4 pl-14 pr-12 text-content-muted transition-all outline-none cursor-not-allowed text-sm font-medium" disabled />
                @if (Model.IsEmailConfirmed)
                {
                    <span class="absolute inset-y-0 right-0 pr-4 flex items-center text-success" title="Email đã xác thực">
                        <iconify-icon icon="solar:check-circle-bold-duotone" class="text-xl"></iconify-icon>
                    </span>
                }
            </div>
            @if (!Model.IsEmailConfirmed)
            {
                <div class="mt-2 px-1">
                    <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="text-xs font-bold text-primary hover:text-accent transition-colors flex items-center gap-1">
                        <iconify-icon icon="solar:shield-warning-bold-duotone" class="text-base"></iconify-icon> Gửi lại email xác thực
                    </button>
                </div>
            }
        </div>

        <!-- New Email -->
        <div class="space-y-3 text-left">
            <label asp-for="Input.NewEmail" class="text-[10px] font-bold uppercase tracking-[0.2em] text-content-muted ml-2">Email mới</label>
            <div class="relative group/input">
                <span class="absolute inset-y-0 left-0 pl-5 flex items-center text-content-muted group-focus-within/input:text-primary transition-colors">
                    <iconify-icon icon="solar:letter-bold-duotone" class="text-2xl"></iconify-icon>
                </span>
                <input asp-for="Input.NewEmail" class="w-full bg-surface-1/60 border border-white/5 focus:border-primary/50 focus:ring-8 focus:ring-primary/5 rounded-2xl py-4 pl-14 pr-4 text-content-primary transition-all outline-none shadow-inner text-sm font-medium placeholder:text-content-muted/30" autocomplete="email" aria-required="true" placeholder="email@example.com" />
            </div>
            <span asp-validation-for="Input.NewEmail" class="text-[10px] text-danger font-bold ml-2"></span>
        </div>

        <div class="pt-6">
            <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="w-full relative overflow-hidden group/btn btn h-16 rounded-3xl bg-primary border-none shadow-[0_20px_40px_-12px_rgba(79,70,229,0.4)] transition-all duration-500 hover:-translate-y-1 active:scale-95 active:translate-y-0">
                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover/btn:animate-shimmer"></div>
                <span class="relative z-10 flex items-center justify-center gap-3 text-white font-outfit text-lg font-bold uppercase tracking-[0.2em]">
                    Thay đổi email <iconify-icon icon="solar:refresh-bold-duotone" class="text-2xl ml-2"></iconify-icon>
                </span>
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
