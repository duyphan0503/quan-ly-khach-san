@{
    Layout = "/Areas/Public/Pages/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/identity/manage/layout.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
}

<div class="min-h-[calc(100vh-80px)] pt-20 pb-12 bg-surface-1 relative overflow-x-hidden">
    <!-- Fluid Decorative Blobs (Liquid Glass Core) -->
    <div class="absolute top-[-10%] right-[-10%] w-[600px] h-[600px] bg-primary/15 rounded-full blur-[120px] animate-pulse pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[-10%] w-[600px] h-[600px] bg-accent/15 rounded-full blur-[120px] animate-pulse pointer-events-none identity-manage-blob-delay"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-[0.02] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="flex flex-col lg:flex-row gap-8 items-start">
            <!-- Sidebar Nav -->
            <aside class="w-full lg:w-96 shrink-0">
                <div class="bg-surface-2/30 backdrop-blur-3xl border border-white/10 rounded-[2.5rem] p-6 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.5)] transition-all duration-500 hover:border-white/20 relative overflow-hidden group/card h-fit sticky top-28">
                    
                    <!-- Decorative inner glow -->
                    <div class="absolute -top-24 -right-24 w-48 h-48 bg-primary/20 rounded-full blur-[60px] opacity-0 group-hover/card:opacity-100 transition-opacity duration-700"></div>

                    <div class="flex items-center gap-5 mb-10 px-4 mt-2">
                        @{
                            var user = await UserManager.GetUserAsync(User);
                            var avatarUrl = HotelManagement.Helpers.AvatarUrlHelper.Normalize(user?.AvatarUrl);
                            var displayName = user?.FullName ?? User.Identity?.Name;
                        }
                        <div class="relative group/avatar">
                            <!-- Decorative glow -->
                            <div class="absolute inset-0 bg-primary/30 blur-xl rounded-full opacity-50 group-hover/avatar:opacity-100 transition-opacity duration-500"></div>
                            
                            <!-- Main Avatar Circle -->
                            <div class="relative w-20 h-20 rounded-full overflow-hidden shadow-lg shadow-primary/20 border border-white/20 bg-surface-3">
                                @if (!string.IsNullOrEmpty(avatarUrl))
                                {
                                    <img id="avatar-preview-sidebar" src="@avatarUrl" alt="Avatar" class="w-full h-full object-cover" data-avatar-image data-avatar-default-src="@HotelManagement.Helpers.AvatarUrlHelper.DefaultAvatar" />
                                }
                                else
                                {
                                    <div class="w-full h-full bg-linear-to-br from-primary to-indigo-600 flex items-center justify-center text-white">
                                        <img id="avatar-preview-sidebar-new" src="" class="hidden w-full h-full object-cover" />
                                        <span id="avatar-initial-sidebar" class="text-3xl font-bold font-outfit uppercase">@(displayName?.Substring(0, 1))</span>
                                    </div>
                                }
                            </div>
                            
                            <!-- Small Camera Button at Bottom Right -->
                            <!-- This now points to the hidden input outside the main nav -->
                            <label for="avatar-upload-global" class="absolute -bottom-1 -right-1 w-8 h-8 rounded-full bg-primary hover:bg-primary-700 text-white flex items-center justify-center cursor-pointer border-2 border-surface-2 shadow-lg transition-all hover:scale-110 active:scale-95 z-20">
                                <iconify-icon icon="solar:camera-bold-duotone" class="text-lg"></iconify-icon>
                            </label>
                        </div>
                        <div class="flex-1 overflow-hidden">
                            <h2 class="font-outfit font-bold text-xl text-content-primary tracking-tight truncate">@displayName</h2>
                            <p class="text-[10px] text-accent font-bold uppercase tracking-[0.2em] mt-1">Cài đặt cá nhân</p>
                        </div>
                    </div>
                    
                    <nav class="relative z-10">
                        <ul class="space-y-2">
                            <partial name="_ManageNav" />
                        </ul>
                    </nav>


                </div>
            </aside>

            <!-- Main Content Area -->
            <main class="flex-1 w-full">
                <div class="bg-surface-2/30 backdrop-blur-3xl border border-white/10 rounded-[2.5rem] p-6 lg:p-8 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.3)] transition-all duration-500 h-fit">
                    <div class="mb-10 relative flex items-center justify-between">
                        <h1 class="text-3xl font-outfit font-bold text-content-primary tracking-tight">@ViewData["Title"]</h1>
                        <div class="absolute -bottom-3 left-0 h-1.5 w-16 bg-linear-to-r from-accent to-transparent rounded-full"></div>
                        @RenderSection("PageActions", required: false)
                    </div>

                    <div class="animate-fade-in text-left">
                        @RenderBody()
                    </div>
                </div>
            </main>
        </div>
    </div>
</div>

<!-- Hidden Form for Avatar Upload (Available on all manage pages) -->
<form id="avatar-form-global" method="post" enctype="multipart/form-data" action="/profile" class="hidden">
    <input id="avatar-upload-global" type="file" name="Input.AvatarFile" accept="image/*" />
    @Html.AntiForgeryToken()
</form>

<div id="upload-overlay-global" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-[9999] hidden flex flex-col items-center justify-center text-white">
    <div class="flex flex-col items-center gap-4">
        <span class="loading loading-spinner loading-lg text-primary"></span>
        <p class="font-bold tracking-widest uppercase text-sm">Đang tối ưu hóa ảnh...</p>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/identity/manage/layout.js" asp-append-version="true" defer></script>
    @RenderSection("Scripts", required: false)
}
