@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    Layout = "_Layout.cshtml";
}

<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post" class="space-y-8 animate-fade-in">
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-error bg-danger/10 border-danger/20 text-danger text-sm p-3 rounded-3xl mb-8" role="alert"></div>
    }

    <div class="space-y-8">
        <!-- Nhập mật khẩu hiện tại để xác minh chủ tài khoản -->
        <div class="space-y-3 text-left">
            <label asp-for="Input.OldPassword" class="text-[10px] font-bold uppercase tracking-[0.2em] text-content-muted ml-2">Mật khẩu hiện tại</label>
            <div class="relative group" data-password-toggle>
                <span class="absolute inset-y-0 left-0 pl-5 flex items-center text-content-muted group-focus-within:text-primary transition-colors">
                    <iconify-icon icon="solar:lock-keyhole-bold-duotone" class="text-2xl"></iconify-icon>
                </span>
                <input asp-for="Input.OldPassword" data-password-toggle-field type="password" class="w-full bg-surface-1/60 border border-white/5 focus:border-primary/50 focus:ring-8 focus:ring-primary/5 rounded-2xl py-4 pl-14 pr-14 text-content-primary transition-all outline-none shadow-inner text-sm font-medium placeholder:text-content-muted/30" autocomplete="current-password" placeholder="••••••••" />
                <button type="button" data-password-toggle-btn class="absolute inset-y-0 right-0 flex items-center pr-4 text-content-muted hover:text-primary transition-colors" aria-label="Hiện mật khẩu" aria-pressed="false">
                    <iconify-icon data-password-toggle-icon icon="lucide:eye" class="text-xl"></iconify-icon>
                </button>
            </div>
            <span asp-validation-for="Input.OldPassword" class="text-[10px] text-danger font-bold ml-2"></span>
        </div>

        <!-- Trường mật khẩu mới theo chính sách bảo mật -->
        <div class="space-y-3 text-left">
            <label asp-for="Input.NewPassword" class="text-[10px] font-bold uppercase tracking-[0.2em] text-content-muted ml-2">Mật khẩu mới</label>
            <div class="relative group" data-password-toggle>
                <span class="absolute inset-y-0 left-0 pl-5 flex items-center text-content-muted group-focus-within:text-primary transition-colors">
                    <iconify-icon icon="solar:lock-password-bold-duotone" class="text-2xl"></iconify-icon>
                </span>
                <input asp-for="Input.NewPassword" data-password-toggle-field type="password" class="w-full bg-surface-1/60 border border-white/5 focus:border-primary/50 focus:ring-8 focus:ring-primary/5 rounded-2xl py-4 pl-14 pr-14 text-content-primary transition-all outline-none shadow-inner text-sm font-medium placeholder:text-content-muted/30" autocomplete="new-password" placeholder="••••••••" />
                <button type="button" data-password-toggle-btn class="absolute inset-y-0 right-0 flex items-center pr-4 text-content-muted hover:text-primary transition-colors" aria-label="Hiện mật khẩu" aria-pressed="false">
                    <iconify-icon data-password-toggle-icon icon="lucide:eye" class="text-xl"></iconify-icon>
                </button>
            </div>
            <span asp-validation-for="Input.NewPassword" class="text-[10px] text-danger font-bold ml-2"></span>
        </div>

        <!-- Xác nhận lại mật khẩu mới trước khi lưu -->
        <div class="space-y-3 text-left">
            <label asp-for="Input.ConfirmPassword" class="text-[10px] font-bold uppercase tracking-[0.2em] text-content-muted ml-2">Xác nhận mật khẩu mới</label>
            <div class="relative group" data-password-toggle>
                <span class="absolute inset-y-0 left-0 pl-5 flex items-center text-content-muted group-focus-within:text-primary transition-colors">
                    <iconify-icon icon="solar:shield-check-bold-duotone" class="text-2xl"></iconify-icon>
                </span>
                <input asp-for="Input.ConfirmPassword" data-password-toggle-field type="password" class="w-full bg-surface-1/60 border border-white/5 focus:border-primary/50 focus:ring-8 focus:ring-primary/5 rounded-2xl py-4 pl-14 pr-14 text-content-primary transition-all outline-none shadow-inner text-sm font-medium placeholder:text-content-muted/30" autocomplete="new-password" placeholder="••••••••" />
                <button type="button" data-password-toggle-btn class="absolute inset-y-0 right-0 flex items-center pr-4 text-content-muted hover:text-primary transition-colors" aria-label="Hiện mật khẩu" aria-pressed="false">
                    <iconify-icon data-password-toggle-icon icon="lucide:eye" class="text-xl"></iconify-icon>
                </button>
            </div>
            <span asp-validation-for="Input.ConfirmPassword" class="text-[10px] text-danger font-bold ml-2"></span>
        </div>

        <div class="pt-6">
            <button type="submit" class="w-full relative overflow-hidden group/btn btn h-16 rounded-3xl bg-primary border-none shadow-[0_20px_40px_-12px_rgba(79,70,229,0.4)] transition-all duration-500 hover:-translate-y-1 active:scale-95 active:translate-y-0">
                <div class="absolute inset-0 bg-linear-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover/btn:animate-shimmer"></div>
                <span class="relative z-10 flex items-center justify-center gap-3 text-white font-outfit text-lg font-bold uppercase tracking-[0.2em]">
                    Cập nhật mật khẩu <iconify-icon icon="solar:refresh-bold-duotone" class="text-2xl ml-2"></iconify-icon>
                </span>
            </button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/common/password-toggle.js" asp-append-version="true"></script>
}
