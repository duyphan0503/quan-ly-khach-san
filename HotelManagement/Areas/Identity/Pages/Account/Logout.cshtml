@page
@model LogoutModel
@inject HotelManagement.Application.Services.Interfaces.IWebsiteSettingsService WebsiteSettingsService
@{
    var websiteSettings = await WebsiteSettingsService.GetCurrentAsync();
    var logoUrl = string.IsNullOrWhiteSpace(websiteSettings.LogoUrl) ? "/images/logo.svg" : websiteSettings.LogoUrl;
    var brandMain = string.IsNullOrWhiteSpace(websiteSettings.BrandMain) ? HotelManagement.Core.Constants.BrandingConstants.BrandMain : websiteSettings.BrandMain;
    var brandHighlight = string.IsNullOrWhiteSpace(websiteSettings.BrandHighlight) ? HotelManagement.Core.Constants.BrandingConstants.BrandHighlight : websiteSettings.BrandHighlight;
    var brandSlogan = string.IsNullOrWhiteSpace(websiteSettings.BrandSlogan) ? HotelManagement.Core.Constants.BrandingConstants.BrandSlogan : websiteSettings.BrandSlogan;
    var brandFullName = string.IsNullOrWhiteSpace(websiteSettings.BrandFullName) ? HotelManagement.Core.Constants.BrandingConstants.BrandFullName : websiteSettings.BrandFullName;
    ViewData["Title"] = "Đăng xuất";
    Layout = "/Areas/Public/Pages/Shared/_Layout.cshtml";
}

<div class="min-h-[calc(100vh-80px)] pt-16 pb-12 flex items-center justify-center relative overflow-hidden bg-surface-1">
    <!-- Fluid Decorative Blobs (Liquid Glass Core) -->
    <div class="absolute top-[-10%] right-[-10%] w-[500px] h-[500px] bg-danger/10 rounded-full blur-[120px] animate-pulse pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[-10%] w-[500px] h-[500px] bg-danger/5 rounded-full blur-[120px] animate-pulse pointer-events-none mq-auth-blob-delay"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-[0.03] pointer-events-none"></div>

    <div class="relative z-10 w-full max-w-md px-6 py-12 text-center">
        <!-- Brand Logo/Header -->
        <div class="text-center mb-8 animate-fade-in">
            <a asp-area="Public" asp-page="/Index" class="inline-flex items-center gap-4 mb-8 group">
                <div class="relative">
                    <div class="absolute inset-0 bg-accent/20 blur-xl rounded-full scale-150 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <img src="@logoUrl" alt="@($"{brandFullName} Logo")" class="relative w-16 h-16 transition-transform duration-500 group-hover:rotate-[360deg] mq-auth-logo" />
                </div>
                <div class="flex flex-col items-start text-left">
                    <span class="text-2xl font-outfit font-extrabold text-content-primary tracking-[0.15em] uppercase leading-none">@brandMain <span class="text-primary">@brandHighlight</span></span>
                    <span class="text-[10px] text-accent font-bold tracking-[0.4em] uppercase mt-2 opacity-80">@brandSlogan</span>
                </div>
            </a>
        </div>

        <div class="bg-surface-2/30 backdrop-blur-3xl border border-white/10 rounded-[32px] p-10 shadow-[0_32px_64px_-16px_rgba(0,0,0,0.5)] hover:border-danger/30 transition-all duration-700">
            <div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-danger/10 text-danger mb-8 shadow-inner shadow-danger/20 border border-danger/20">
                <iconify-icon icon="solar:logout-3-bold-duotone" class="text-5xl"></iconify-icon>
            </div>

            <h1 class="text-3xl font-outfit font-bold text-content-primary mb-3 tracking-tight">Đăng Xuất</h1>
            <p class="text-content-muted mb-10 text-sm leading-relaxed">Đừng quên quay lại để cập nhật những ưu đãi mới nhất từ @brandFullName.</p>

            <div class="space-y-4">
                @{
                    if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "Public" })" method="post">
                            <button type="submit" class="w-full relative overflow-hidden group/btn btn h-16 rounded-[20px] bg-danger hover:bg-danger border-none shadow-[0_20px_40px_-12px_rgba(239,68,68,0.4)] transition-all duration-500 hover:-translate-y-1 active:scale-95 active:translate-y-0">
                                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover/btn:animate-shimmer"></div>
                                <span class="relative z-10 flex items-center justify-center gap-3 text-white font-outfit text-lg font-bold uppercase tracking-[0.2em]">
                                    Xác Nhận Thoát <iconify-icon icon="solar:check-read-bold-duotone" class="text-2xl"></iconify-icon>
                                </span>
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert bg-success/10 border border-success/20 text-success rounded-2xl p-4 mb-6 flex items-center gap-3">
                            <iconify-icon icon="solar:check-circle-bold-duotone" class="text-2xl"></iconify-icon>
                            <span class="font-medium text-sm tracking-wide">Bạn đã đăng xuất thành công.</span>
                        </div>
                    }
                }

                <div class="mt-8 pt-6 border-t border-white/5 text-center">
                    <a asp-area="Public" asp-page="/Index" class="text-sm font-bold text-content-secondary hover:text-primary transition-colors flex items-center justify-center gap-2 underline underline-offset-8 decoration-white/10 hover:decoration-primary/50">
                        <iconify-icon icon="solar:home-smile-bold-duotone" class="text-lg"></iconify-icon> Quay lại trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
